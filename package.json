{
  "name": "warpdiff",
  "version": "1.0.0",
  "description": "A browser-based Stack and Grid comparison tool for reviewing 1–3 images, videos, or audio files.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ownership": "node tests/ownership.test.mjs",
    "test:preparation": "node --test --test-concurrency=1 tests/media-prepare.test.mjs tests/local-companion.test.mjs",
    "test:fixtures": "bash tests/fixtures/generate.sh",
    "test:ci": "playwright test --config=playwright.ci.config.ts --project=chromium --workers=1 --retries=0",
    "test:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:infra": "node --test tests/release-infrastructure.test.mjs",
    "test:mutations": "node tools/investigations/opus-timing/mutation-check.mjs",
    "test:color": "node tools/investigations/sdr-color/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayriddle/warpdiff.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jayriddle/warpdiff/issues"
  },
  "homepage": "https://github.com/jayriddle/warpdiff#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "serve": "^14.2.5",
    "yaml": "2.9.1"
  }
}
